{
  "expo": {
    "name": "Halalzur",
    "slug": "halalzur",
    "version": "1.0.0",
    "scheme": "halalzur",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.halalzur.app",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Halalzur məhsulun barkodunu skan edərək halallıq statusunu yoxlamaq üçün kameraya ehtiyac duyur.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": ["whatsapp"]
      }
    },
    "android": {
      "package": "com.halalzur.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0A4D2E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Halalzur məhsulun barkodunu skan edərək halallıq statusunu yoxlamaq üçün kameraya ehtiyac duyur."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Halalzur tərkib siyahısının şəklini çəkmək üçün kameraya ehtiyac duyur."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Halalzur yaxınlıqdakı halal sertifikatlı məkanları göstərmək üçün məkan icazəsinə ehtiyac duyur."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "@react-native-google-signin/google-signin",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A4D2E"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ],
      "./plugins/withFirebaseDisableSPM"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "30e2f9e0-9a10-4799-900e-edeefb2e968d"
      }
    }
  }
}
