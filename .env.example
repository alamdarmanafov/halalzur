# Copy this file to `.env`, fill in your Supabase project's values, then
# restart `expo start`. Both must start with EXPO_PUBLIC_ so Expo inlines
# them into the app bundle — that also means they end up readable in the
# shipped app, so only ever put the "anon" (public) key here, never the
# service_role key.
#
# Find these under Supabase → Project Settings → API.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed to run `npm run sync` (scripts/sync/) locally — never add the
# EXPO_PUBLIC_ prefix to this one, or it would ship inside the app bundle.
# Get it from Supabase → Project Settings → API Keys → service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
