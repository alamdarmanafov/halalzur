# Copy this file to `.env`, fill in your Supabase project's values, then
# restart `expo start`. Both must start with EXPO_PUBLIC_ so Expo inlines
# them into the app bundle — that also means they end up readable in the
# shipped app, so only ever put the "anon" (public) key here, never the
# service_role key.
#
# Find these under Supabase → Project Settings → API.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed to run `npm run sync` (scripts/sync/) locally — never add the
# EXPO_PUBLIC_ prefix to this one, or it would ship inside the app bundle.
# Get it from Supabase → Project Settings → API Keys → service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Real push notifications (lib/pushNotify.ts) — the admin panel's deployed
# Vercel URL (no trailing slash) and a shared secret that must match the
# NOTIFY_SECRET you set on that Vercel project (Settings → Environment
# Variables). See admin-panel/api/send-notification.js for the full list
# of server-side variables that endpoint itself needs (Firebase service
# account + Supabase service_role key).
EXPO_PUBLIC_ADMIN_API_URL=https://your-admin-panel.vercel.app
EXPO_PUBLIC_NOTIFY_SECRET=pick-any-long-random-string

# Google Sign-In — the "CLIENT_ID" value from GoogleService-Info.plist
# (Firebase Console → Authentication → Sign-in method → Google must be
# enabled first, which is what makes Firebase generate this). Not a
# secret — it's the public OAuth client identifier, safe to ship.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-id.apps.googleusercontent.com
